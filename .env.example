# 비워 두면 하드코딩 대사 풀을 사용하는 mock 모드로 실행됩니다.
OPENAI_API_KEY=

# OpenAI Chat Completions 모델
OPENAI_MODEL=gpt-4o-mini

# Express/Socket.io 서버 포트. Railway에서는 플랫폼이 자동으로 주입합니다.
PORT=3000

# 자동 E2E 전용 타이머 배율입니다. 실제 플레이에서는 1을 유지하세요.
GAME_TIME_SCALE=1

# GitHub Pages처럼 프런트와 서버를 따로 배포할 때만 사용합니다.
# 브라우저에 공개되는 서버 주소이며 OpenAI API 키를 넣으면 안 됩니다.
VITE_SOCKET_URL=
