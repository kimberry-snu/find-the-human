# 비워 두면 하드코딩 대사 풀을 사용하는 mock 모드로 실행됩니다.
OPENAI_API_KEY=

# 공개 서버에서 사용할 OpenAI Chat Completions 모델
OPENAI_MODEL=gpt-5.6-luna

# OpenAI 호출 비용/트래픽 보호 장치입니다. 모두 서버 프로세스 단위로 적용됩니다.
# UTC 날짜가 바뀌면 일일 사용량을 초기화합니다.
OPENAI_DAILY_BUDGET_USD=0.50
OPENAI_ROOM_DAILY_BUDGET_USD=0.05
OPENAI_REQUESTS_PER_MINUTE=30
OPENAI_MAX_CONCURRENCY=2

# Express/Socket.io 서버 포트. Render 등 호스팅 플랫폼에서는 자동으로 주입합니다.
PORT=3000

# 프런트와 서버를 분리 배포할 때 허용할 브라우저 Origin입니다.
# 쉼표로 여러 주소를 구분합니다. 단일 서버 배포는 비워도 같은 Origin이 허용됩니다.
CLIENT_ORIGIN=

# 자동 E2E 전용 타이머 배율입니다. 실제 플레이에서는 1을 유지하세요.
GAME_TIME_SCALE=1

# 자동 E2E에서만 1로 설정합니다. 공개 서버에서는 비워 두세요.
RATE_LIMIT_DISABLED=

# GitHub Pages처럼 프런트와 서버를 따로 배포할 때만 사용합니다.
# 브라우저에 공개되는 서버 주소이며 OpenAI API 키를 넣으면 안 됩니다.
VITE_SOCKET_URL=
